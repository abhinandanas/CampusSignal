# CampusSignal Backend — Environment Variables Example
# Copy to .env and replace the PostgreSQL placeholders. Never commit .env.
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:3000

# Use either DATABASE_URL or the DB_* fields below.
# DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/campus_signal
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_signal
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DATABASE_SSL=false

DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000
