# CampusSignal Backend — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── CORS ─────────────────────────────────────────────────
# URL of the Next.js frontend (used to allow cross-origin requests)
FRONTEND_ORIGIN=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────────
# Replace each placeholder with your actual database credentials.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campussignal_db
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Connection pool size (optional tuning)
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000
